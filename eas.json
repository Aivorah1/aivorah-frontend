{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "development-staging": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.aivorah.ai"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "preview-staging": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.aivorah.ai"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": { "resourceClass": "m-medium" }
    }
  },
  "submit": {
    "production": {}
  }
}
